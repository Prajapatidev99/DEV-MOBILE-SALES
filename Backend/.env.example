# Backend Environment Variables Template
# Copy this file to .env and fill in your values

# Gemini AI API Key (for AI-powered features)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Configuration (for order notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Firebase Service Account (JSON string or use serviceAccount.json file)
# Option 1: Use serviceAccount.json file (recommended for local development)
# Option 2: Set this environment variable with the full JSON content
FIREBASE_SERVICE_ACCOUNT_JSON=

# Frontend URL for CORS configuration
FRONTEND_URL=https://devmobile.shop

# Node Environment (development or production)
NODE_ENV=development

# Note: BACKEND_API_SECRET is DEPRECATED and no longer used
# Authentication now uses Firebase ID tokens verified by Firebase Admin SDK
